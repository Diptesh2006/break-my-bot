# Compose database and target access
POSTGRES_DB=breakmybot
POSTGRES_USER=breakmybot
POSTGRES_PASSWORD=replace-with-a-local-development-password
BREAKMYBOT_ALLOWED_HOSTS=host.docker.internal
BREAKMYBOT_REQUEST_TIMEOUT_SECONDS=15

# Optional planner; no model calls unless you pass --plan-with-ai and consent
BREAKMYBOT_LLM_PROVIDER=nrouter
NROUTER_API_KEY=
BREAKMYBOT_PLANNER_MODEL=

# For a named gateway, set BREAKMYBOT_LLM_PROVIDER to openai, openrouter, groq,
# gemini, mistral, or deepseek; set its native API key and model.
# For another OpenAI-compatible gateway, uncomment and configure:
# BREAKMYBOT_LLM_PROVIDER=openai-compatible
# BREAKMYBOT_LLM_BASE_URL=https://gateway.example/v1
# BREAKMYBOT_LLM_API_KEY_ENV=MY_GATEWAY_API_KEY
# BREAKMYBOT_LLM_MODEL=
